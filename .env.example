# =============================================================================
# B&B Market - environment template
# =============================================================================
# Copy to `.env` for local development, or to `.env.prod` on the OVH VPS.
#   local:   cp .env.example .env
#   OVH VPS: sudo cp .env.example /var/www/bb-market/.env.prod
#
# NEVER commit a filled-in copy. Both `.env` and `.env.*` are gitignored;
# only this example file is tracked.
#
# server/env.ts loads `.env` when NODE_ENV != production and `.env.prod`
# when NODE_ENV=production. dotenv is called with `override: true`, so these
# files win over the systemd unit's Environment= lines. That is intentional:
# the file is the single source of truth for the running service.
# =============================================================================


# --- Runtime -----------------------------------------------------------------

# REQUIRED in production. Switches the server to production mode:
#   - loads .env.prod instead of .env
#   - enables secure session cookies
#   - makes Express trust one reverse-proxy hop (required for Nginx + HTTPS)
#   - refuses to start against SQLite (see DATABASE_URL below)
NODE_ENV=production

# Port the Express API listens on. Keep this on 127.0.0.1 via the bind below;
# Nginx is the only thing that should reach it.
PORT=5000

# Bind address for the Node process. Loopback-only is the safe default because
# Nginx proxies to it, and an open port 5000 on a VPS bypasses TLS termination
# and the secure-cookie protection entirely. Set HOST=0.0.0.0 only if a firewall
# already restricts access to port 5000.
HOST=127.0.0.1


# --- Database ----------------------------------------------------------------

# REQUIRED in production. Must be a PostgreSQL connection string.
# The server picks its dialect from this value:
#   postgres:// or postgresql:// -> PostgreSQL (server/db-schema.ts pgSchema)
#   anything else / unset        -> SQLite, local development only
#
# Create the database and role first:
#   sudo -u postgres psql -c "CREATE ROLE bbmarket LOGIN PASSWORD 'CHANGE_ME';"
#   sudo -u postgres psql -c "CREATE DATABASE bb_market OWNER bbmarket ENCODING 'UTF8';"
#
# Use 127.0.0.1 rather than localhost: on many systems localhost resolves to
# ::1 first, and PostgreSQL often only listens on IPv4.
DATABASE_URL=postgresql://bbmarket:CHANGE_ME@127.0.0.1:5432/bb_market

# TLS to PostgreSQL. Defaults to enabled (rejectUnauthorized:false, which
# encrypts without requiring a CA bundle in the image). Set to "false" ONLY for
# a local socket or a private network you control.
DATABASE_SSL=true

# Connection pool size for the pg Pool. 10 is plenty for a small storefront.
DATABASE_POOL_MAX=10

# Safety interlock. The server THROWS on startup if it resolves a SQLite
# database while NODE_ENV=production, because that would silently write to a
# local file and lose all data on restart. Set to 1 only if you deliberately
# want SQLite in production.
ALLOW_SQLITE_IN_PRODUCTION=


# --- Sessions / auth ---------------------------------------------------------

# REQUIRED in all environments. The server refuses to boot without it.
# There is no default and it is never logged.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Google OAuth client ID, used server-side to verify the credential token.
# Same value as VITE_GOOGLE_CLIENT_ID below.
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Public Google OAuth client ID, injected into the frontend bundle at build
# time (client/src/App.tsx reads import.meta.env.VITE_GOOGLE_CLIENT_ID).
# IMPORTANT: this is compiled into JS and is therefore public. Restrict it in
# the Google console to your exact production origins.
#
# Because Vite inlines this at BUILD time, you must set it before `npm run build`
# on the VPS (or pass it into the build command).
VITE_GOOGLE_CLIENT_ID=

# Canonical public URL of the site. Used for OAuth redirect construction and
# any absolute links in emails.
APP_URL=https://example.com

# REQUIRED only when running `npm run set-password` / server/seed-admin.ts.
# The script has no default password and fails without it.
# Generate:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SEED_ADMIN_PASSWORD=

# Set to 1 to let the seed script update the password of existing admins.
SEED_ADMIN_UPDATE_EXISTING=


# --- Authorisation policy (read this before creating accounts) ---------------

# How admins are created
# ---------------------
# There is NO public endpoint that can grant admin or superadmin. POST
# /api/register always creates a customer account, and it stays that way in
# production even for the owner's own email addresses. Role grants happen in
# exactly two places, both requiring shell or superadmin access:
#
#   1. server/seed-admin.ts, run from a shell before the site goes public:
#        cd /var/www/bb-market
#        sudo -u bbmarket -E NODE_ENV=production \
#          SEED_ADMIN_PASSWORD='STRONG_PASS' npx tsx server/seed-admin.ts
#
#   2. POST /api/admin/users, which requires an authenticated superadmin.
#
# Why this is not configurable back: /api/register never verifies that the caller
# owns the email address it is given, so any email-allowlist on that endpoint
# would let anyone claim an owner address and take over the store. The policy
# lives in server/roles.ts and is verified by `npm run test:auth`.

# Local development convenience only: promote the very first account on an
# empty database to superadmin, so a fresh clone has an admin without running
# the seed script.
#
# Defaults to OFF. Set to 1 to enable.
#
# This is IGNORED when NODE_ENV=production, regardless of its value, so it
# cannot be switched on by accident on the VPS.
ALLOW_DEV_FIRST_USER_SUPERADMIN=false


# --- Transactional email (SMTP) ---------------------------------------------

# Contact-form messages, password-reset links, welcome and stock-alert emails.
# Without these the app still boots, but those features fail at runtime.
# OVH: use an OVH "Sendmail"/SMTP relay or an external provider (Brevo, Mailjet).
SMTP_USER=
SMTP_PASS=


# --- Product image storage (Cloudinary) -------------------------------------

# Uploads go to Cloudinary via server/cloudinary_util.ts. If these are unset
# the app falls back to writing into UPLOADS_DIR (default public/uploads), which
# works but means images live on the VPS. Recommended in production so images
# survive a VPS rebuild.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# --- Automated backups (Backblaze B2 + pg_dump) -----------------------------

# server/backup.ts runs pg_dump against DATABASE_URL and uploads the dump to B2.
# Requires the `postgresql-client` package on the VPS (provides pg_dump).
# Leave blank to disable backups; the cron job then logs and skips.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_REGION=


# --- Uploads -----------------------------------------------------------------

# Max upload size in bytes, enforced by Multer. Default 10485760 (10 MB).
# Nginx's client_max_body_size should match.
MAX_UPLOAD_BYTES=10485760

# Directory served at /uploads. Defaults to <project root>/public/uploads.
#
# Keep it OUTSIDE dist/. `npm run build` empties dist/, so anything stored there
# is deleted on the next deploy and every product image 404s afterwards.
# Only needed if you mount the uploads directory somewhere else, e.g.
#   UPLOADS_DIR=/var/www/bb-market-data/uploads
UPLOADS_DIR=

# Absolute path to the checkout root. Only set this if the automatic detection
# in server/paths.ts picks the wrong directory (for example when the app runs
# from a symlinked release directory). Normally left empty.
PROJECT_ROOT=

# Explicit env file to load, bypassing the .env / .env.prod convention.
# Only needed for unusual layouts; leave empty otherwise.
ENV_FILE=


# --- Development-only conveniences -------------------------------------------

# Inserts the five SRED demo products when the products table is empty.
# Hard-disabled when NODE_ENV=production, so a fresh production database can
# never be polluted with placeholder items priced at 0.
SEED_DEMO_PRODUCTS=
