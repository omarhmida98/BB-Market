node_modules
dist
.DS_Store
server/public
vite.config.ts.*
*.tar.gz
.env
.env.*
!.env.example
shared/*.js

# Throwaway SQLite databases and journals created by the test/smoke scripts.
# `.env.*` above already covers their generated env files.
server/*_rt.db
server/*_rt.db-journal
server/*_rt.db-wal
server/*_rt.db-shm
server/smoke_ui.db
server/smoke_ui.db-journal
server/smoke_ui.db-wal
server/smoke_ui.db-shm
# Throwaway uploads dir created by test-security-routes.ts.
server/security_rt_uploads/

# Database and upload backups written by `npm run db:reset-data`. They hold
# password hashes and customer details, so they never belong in the repository.
server/backups/

# Local SQLite databases, their WAL/journal sidecars and dated backups. These
# hold user rows (password hashes) and are dev/runtime state, never source — the
# app runs on PostgreSQL in production and schema lives in server/migrations/*.sql
# (which are .sql, not .db, so none of these patterns touch them).
*.db
*.db-journal
*.db-wal
*.db-shm
server/*.db
server/*.db.backup-*
*.db.backup-*

# Uploaded product images. These are runtime user content (served at /uploads),
# not source; production stores them in Cloudinary. The directory is recreated on
# startup, so ignoring it cannot break the app.
public/uploads/
