{
  "name": "sred-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx index.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node start-prod.js",
    "db:push": "echo Replace db:push with: npm run db:generate   (then)   npm run db:migrate   -- drizzle-kit push has a duplicate-index bug on SQLite and can drop tables without asking.",
    "db:generate": "drizzle-kit generate",
    "db:generate:pg": "drizzle-kit generate --config=drizzle.pg.config.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:baseline": "tsx scripts/baseline.ts",
    "set-password": "tsx scripts/set-password.ts",
    "db:reset-data": "tsx scripts/reset-data.ts",
    "test:auth": "tsx scripts/test-registration-role.ts && tsx scripts/test-seed-admin.ts",
    "test:seed": "tsx scripts/test-seed-admin.ts",
    "test:load": "tsx scripts/loadtest-products.ts",
    "test:promotions": "tsx scripts/test-promotions.ts",
    "test:promo-routes": "tsx scripts/test-promo-routes.ts",
    "test:account-routes": "tsx scripts/test-account-routes.ts",
    "test:wishlist-routes": "tsx scripts/test-wishlist-routes.ts",
    "test:analytics-routes": "tsx scripts/test-analytics-routes.ts",
    "test:analytics-perf": "tsx scripts/test-analytics-perf.ts",
    "smoke:account-ui": "tsx scripts/smoke-account-ui.ts",
    "test:pg-rehearsal": "tsx scripts/test-pg-rehearsal.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.714.0",
    "@aws-sdk/lib-storage": "^3.714.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.8.0",
    "cloudinary": "^2.5.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.7.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "google-auth-library": "^10.9.1",
    "memorystore": "^1.6.7",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.12",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.16.3",
    "ws": "^8.18.0",
    "zod": "^3.25.76",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^1.4.11",
    "@types/node": "20.19.27",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.7",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.31.8",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.5",
    "typescript": "5.6.3"
  }
}
